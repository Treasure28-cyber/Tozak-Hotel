{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "npm run build && npm run check",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/facilities",
      "destination": "/#pool",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/#welcome",
      "permanent": true
    }
  ]
}
